<!DOCTYPE html>
<html>
<head>
    <title>AWS S3 File Upload</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="container">

    <h1>AWS S3 File Upload</h1>

    <p>Select a file and upload it to Amazon S3.</p>

    <form
        action="/upload"
        method="POST"
        enctype="multipart/form-data">

        <input
            type="file"
            name="myFile"
            required>

        <br><br>

        <button type="submit">
            Upload
        </button>

    </form>

    <hr>

    <h2>Uploaded Files</h2>

    <% if (files.length === 0) { %>

        <p>No files uploaded.</p>

    <% } else { %>

        <table>

            <thead>
                <tr>
                    <th>File Name</th>
                    <th>Size</th>
                    <th>Last Modified</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                <% files.forEach(file => { %>

                    <tr>
                        <td><%= file.key %></td>
                        <td><%= file.size %></td>
                        <td><%= file.lastModified %></td>
                        <td>
                        <td>

                            <form action="/upload/delete" method="POST">

                                <input
                                    type="hidden"
                                    name="fileName"
                                    value="<%= file.key %>">

                                <button
                                    type="submit"
                                    onclick="return confirm('Are you sure you want to delete this file?')">
                                    Delete
                                </button>

                             </form>

                        </td>
                        </td>
                    </tr>

                <% }) %>

            </tbody>

        </table>

    <% } %>

</div>

</body>
</html>